      <column caption='Total Patients' datatype='integer' name='[Calculation_1626238572380160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([LUNG_CANCER])' />
      </column>
      <column caption='Cancer cases' datatype='integer' name='[Calculation_1626238572515329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [LUNG_CANCER] = &quot;YES&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Cancer Outcome %' datatype='real' name='[Calculation_1626238572597250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [LUNG_CANCER] = &quot;YES&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([LUNG_CANCER])' />
      </column>
      <column caption='Average Age' datatype='real' name='[Calculation_1626238572691459]' role='measure' type='quantitative'>
